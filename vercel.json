{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/ai/recipe-recommendation.ts": {
      "maxDuration": 25
    },
    "api/ai/meal-plan-trial.ts": {
      "maxDuration": 35
    },
    "api/ai/meal-plan-recipe-detail.ts": {
      "maxDuration": 35
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/dashboard",
      "destination": "/api/admin?action=dashboard"
    },
    {
      "source": "/api/admin/ai-switch",
      "destination": "/api/admin?action=ai-switch"
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
