# Server only. Never prefix this value with VITE_.
OPENAI_API_KEY=

# The default is gpt-5.6-luna when omitted.
OPENAI_MODEL=gpt-5.6-luna

# Optional local UI QA. Ignored in production.
HOMEOS_AI_MOCK=false

# Optional server-only operator feedback receiver.
# Use an HTTPS webhook owned by the operator. Never prefix with VITE_.
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_TOKEN=

# Google OAuth / Server Identity
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
AUTH_COOKIE_SECRET=
DATABASE_URL=

# Server-only R5 business operations.
# Internal auth_users.id values allowed to open /?page=admin.
ADMIN_USER_IDS=

# Google Play Android Publisher verification.
GOOGLE_PLAY_PACKAGE_NAME=com.todaytable.app
GOOGLE_PLAY_PREMIUM_PRODUCT_IDS=
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
# Keep escaped newlines (\\n) when stored as one Vercel value.
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=

# Public Google Play subscription product ID used only by the installed app UI.
# Product IDs are public metadata; never put service-account values behind VITE_.
VITE_GOOGLE_PLAY_PREMIUM_PRODUCT_ID=

# Optional price overrides used only for server-side estimates.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
