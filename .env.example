# Server only. Never prefix this value with VITE_.
OPENAI_API_KEY=

# The default is gpt-5.6-luna when omitted.
OPENAI_MODEL=gpt-5.6-luna

# Optional local UI QA. Ignored in production.
HOMEOS_AI_MOCK=false

# Optional server-only operator feedback receiver.
# Use an HTTPS webhook owned by the operator. Never prefix with VITE_.
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_TOKEN=
